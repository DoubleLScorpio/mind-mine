# MindMine 环境配置示例
#
# 用法：cp .env.example .env 然后填入真实值。
# .env 已被 .gitignore 排除，绝不要提交任何密钥。

# ==========================================================================
# Provider 开关：每个外部依赖都能独立 fallback
#
#   real  强制真实能力，失败就报错（用于排查问题）
#   mock  强制演示数据（Demo 兜底，永远可用）
#   auto  优先真实，失败自动退回 mock（推荐，Demo 默认）
# ==========================================================================

LLM_PROVIDER=auto
ZHIHU_PROVIDER=auto
PROFILE_PROVIDER=auto

# ==========================================================================
# LLM
#
# 兼容任意 OpenAI 协议的服务。留空 LLM_API_KEY 时，
# auto 模式会自动全程走 Demo 脚本，演示仍然可用。
# ==========================================================================

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 单次调用超时（秒）。不要让用户无限等待。
LLM_TIMEOUT_SECONDS=24
# 失败重试次数。再次失败即 fallback 到 Demo 内容。
LLM_MAX_RETRIES=1

# --- 其他兼容服务的参考配置 ---
# 火山方舟（豆包）
#   LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   LLM_MODEL=<你的推理接入点 ID>
# DeepSeek
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# Moonshot
#   LLM_BASE_URL=https://api.moonshot.cn/v1
#   LLM_MODEL=moonshot-v1-8k

# ==========================================================================
# 知乎
#
# Access Secret 不在这里配置 —— 它由知乎 CLI 保存在操作系统凭证库中，
# 通过 `zhihu-cli auth set --secret-stdin` 设置，不写入项目目录。
# 这里只配置 CLI 位置与超时。
# ==========================================================================

# 留空则使用看山工作台内置 CLI 的默认路径
ZHIHU_CLI_PATH=
ZHIHU_TIMEOUT_SECONDS=20

# ==========================================================================
# 知乎 OAuth（「用知乎认识我」的真实用户登录）
#
# 关键区分：
#   ZHIHU_ACCESS_SECRET 是「开放平台调用方」凭据，只用于调用用户数据 API 时的
#   Authorization: Bearer 头；它绝不代表当前访问 MindMine 的用户。
#   当前用户的身份来自 OAuth 授权后换取的 access_token（X-OAuth-Token）。
#
#   ZHIHU_APP_ID / ZHIHU_APP_KEY 由知乎开发者后台签发，仅后端使用。
#   ZHIHU_OAUTH_REDIRECT_URI 必须是知乎回调到后端的完整公开地址（Railway），
#   不能是 localhost；且必须在知乎开发者后台登记为一致。
#   FRONTEND_URL 是前端公开地址（Vercel），OAuth 完成后 302 回这里。
# ==========================================================================

ZHIHU_ACCESS_SECRET=
ZHIHU_APP_ID=
ZHIHU_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=
FRONTEND_URL=http://localhost:5173
# 生产 HTTPS 下置为 true，让 OAuth state cookie 只走 Secure
OAUTH_COOKIE_SECURE=false

# ==========================================================================
# 日志
#
# 只记录 session_id / stage / provider / latency / fallback，
# 绝不记录任何密钥或完整 token。
# ==========================================================================

LOG_LEVEL=INFO
VERBOSE_PROVIDER_LOG=true
